#!/bin/bash

#SBATCH -J ectranCompileJob
#SBATCH --nodes=1
#SBATCH --time "60"
#SBATCH --ntasks-per-node=128
#SBATCH -o ectransCompileJob.o%j

testFolderName=$1
echo "Testing in ${testFolderName}"
ARCH=$2

#== copy test folder to TMPDIR and go into it

cp -r $WORKDIR/${testFolderName} $TMPDIR
cd $TMPDIR/${testFolderName}


# bull specific environment variables
set -x
ulimit -s unlimited


#== load compilation environment

source $ARCH/env.sh

#== Compilation

echo compiling fiat 
cmake -S fiat -B fiat/build -DCMAKE_Fortran_FLAGS="-fPIC" -DCMAKE_POSITION_INDEPENDENT_CODE=ON
cmake --build fiat/build -j 8 

if [ -d $FFTW_ARCHIVE_NAME ]; then
  echo compiling fftw

  # double precision
  cmake -S ${FFTW_ARCHIVE_NAME} -B ${FFTW_ARCHIVE_NAME}/build -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=${FFTW_ARCHIVE_NAME}/install
  cmake --build ${FFTW_ARCHIVE_NAME}/build -j 8
  cmake --install ${FFTW_ARCHIVE_NAME}/build

  # simple precision
  cmake -S ${FFTW_ARCHIVE_NAME} -B ${FFTW_ARCHIVE_NAME}/build -DBUILD_SHARED_LIBS=ON -DENABLE_FLOAT=ON -DCMAKE_INSTALL_PREFIX=${FFTW_ARCHIVE_NAME}/install
  cmake --build ${FFTW_ARCHIVE_NAME}/build -j 8
  cmake --install ${FFTW_ARCHIVE_NAME}/build

  # useful import for ectrans
  export FFTW_ROOT=$TMPDIR/${testFolderName}/${FFTW_ARCHIVE_NAME}/install
  echo FFTW_ROOT=${FFTW_ROOT}

fi

echo compiling ectrans
cmake -S ectrans -B ectrans/build -Dfiat_ROOT=$PWD/fiat/build -DECTRANS_ENABLE_GPU=ON -DENABLE_HIP=ON -DENABLE_OMP=ON 
cmake --build ectrans/build -j 8

#== Tests
#cd ./ectrans/build
#ctest -j $SLURM_NTASKS_PER_NODE -R "ectrans_test_trans_api_dir_trans_call_mode_2_wind_1_cpu_dp_mpi2xomp8"
#ctest -R "gpu"
