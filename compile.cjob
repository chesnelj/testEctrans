#!/bin/bash
#SBATCH -p normal256
#SBATCH -J ectranCompileJob
#SBATCH --nodes=1
#SBATCH --time "5"
#SBATCH -o ectransCompileJob.o%j

if [[ -z "${testFolderName+x}" ]]; then
    echo "No valid test folder name in environment variable"
    exit
else
    echo "Testing in ${testFolderName}"
fi

#== copy test folder to TMPDIR and go into it

cp -r $WORKDIR/${testFolderName} $TMPDIR
cd $TMPDIR/${testFolderName}


# bull specific environment variables
set -x
ulimit -s unlimited

#== Modules
module purge 

module load cmake/3.31.0 1> /dev/null
module load intel/oneapi/2023.2 1> /dev/null
module load compiler/2023.2.0 1> /dev/null
module load mkl/2023.2.0 1> /dev/null
module load mpi/2021.10.0 1> /dev/null
module load gcc/9.2.0 1> /dev/null
module load python/3.10.12 1> /dev/null
module load perl/5.40.1 1> /dev/null


#== ifort set intel compiler
export FC=ifort
export F90=ifort
export CC=icc
export CXX=icpc
export OMPI_FC=ifort
export OMPI_F90=ifort
export OMPI_CC=icc
export OMPI_CXX=icpc
export I_MPI_FC=ifort
export I_MPI_F90=ifort
export I_MPI_CC=icc
export I_MPI_CXX=icpc

export ecbuild_DIR=./ecbuild

# Compilation

cmake -S fiat -B fiat/build
cmake --build fiat/build -j 4


cmake -S ectrans -B ectrans/build -Dfiat_ROOT=$PWD/fiat/build 
cmake --build ectrans/build -j 4

# Tests
cd ./ectrans/build
ctest -j 64









