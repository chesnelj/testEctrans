#!/bin/bash

#
#SBATCH --ntasks-per-node 8
#SBATCH --gpus-per-node=4 
#SBATCH --gres=gpu:1
#SBATCH --partition=gpu_debug
#SBATCH --mem=32000
#SBATCH --qos=dg
#SBATCH -J ectranCompileJob
#SBATCH --nodes=1
#SBATCH --time "30"
#SBATCH -o ectransCompileJob.o%j

testFolderName=$1
echo "Testing in ${testFolderName}"
ARCH=$2

#== copy test folder to TMPDIR and go into it

cp -r $WORKDIR/${testFolderName} $TMPDIR
cd $TMPDIR/${testFolderName}


# bull specific environment variables
set -x
ulimit -s unlimited


#== load compilation environment

source $ARCH/env.sh

#== Compilation

# fiat
cmake -S fiat -B fiat/build -DCMAKE_Fortran_FLAGS="-fPIC" -DCMAKE_POSITION_INDEPENDENT_CODE=ON
cmake --build fiat/build -j 8 


cmake -S ectrans -B ectrans/build -Dfiat_ROOT=$PWD/fiat/build -DECTRANS_ENABLE_GPU=ON -DENABLE_ACC=ON
cmake --build ectrans/build -j 8

# demonstrator
cmake -S demonstrator -B demonstrator/build -Dfiat_ROOT=$PWD/fiat/build  -Dectrans_ROOT=$PWD/ectrans/build
cmake --build demonstrator/build -j 8


#== Tests
cd ./ectrans/build
# all GPU tests
#ctest -R "gpu"
# specific GPU test
#ctest -R "ectrans_test_trans_api_dir_trans_call_mode_2_wind_1_gpu_sp_mpi1xomp1"
# with profiling
nsys profile --trace=cuda,nvtx,mpi -o profil_mpi_cuda mpiexec -n 1 $TMPDIR/testEctrans/ectrans/build/bin/dir_trans_test_suite_gpu_sp ectrans_test_trans_api_dir_trans_call_mode_2_wind_1
cp profil_mpi_cuda.nsys-rep $WORKDIR/${testFolderName}


