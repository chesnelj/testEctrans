#!/bin/bash
#SBATCH -p par 
#SBATCH -J ectranCompileJob
#SBATCH --nodes=1
#SBATCH --time "5"
#SBATCH -o ectransCompileJob.o%j


if [[ -z "${testFolderName+x}" ]]; then
    echo "No valid test folder name in environment variable"
    testFolderName=testEctrans
fi

echo "Testing in ${testFolderName}"

#== copy test folder to TMPDIR and go into it

cp -r $WORKDIR/${testFolderName} $TMPDIR
cd $TMPDIR/${testFolderName}


# bull specific environment variables
set -x
ulimit -s unlimited


#== load compilation environment

source ./arch/ecmwf/hpc2020/intel/2021.4.0/hpcx-openmpi/2.9.0/env.sh

#== Compilation

cmake -S fiat -B fiat/build
cmake --build fiat/build -j 8 


cmake -S ectrans -B ectrans/build -Dfiat_ROOT=$PWD/fiat/build 
cmake --build ectrans/build -j 8

#== Tests
cd ./ectrans/build
ctest -j 128
